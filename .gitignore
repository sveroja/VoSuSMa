# Untis-Export). Nichts davon gehoert ins Repo.
/*.csv
LessonStudentList*
/import/
/beispieldaten/

# DB-Dateien und Backup-Snapshots grundsaetzlich ueberall ignorieren
*.sqlite3
*.sqlite
*.db

# Internes Arbeitsdokument (Excel-Analyse). Bei Bedarf bewusst mit
# `git add -f importTool.ods` aufnehmen.
/*.ods

